{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "timeout": 30000,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--force-prefers-reduced-motion",
        "--blink-settings=preferredColorScheme=1"
      ]
    }
  },
  "urls": [
    "http://localhost:8080/",
    "http://localhost:8080/kontakt"
  ]
}
