# --- Kontaktformular ---
# Diese Datei nach .env kopieren und Werte eintragen.
# .env NIEMALS committen (in .gitignore aufnehmen).
# In Produktion die Werte in den Umgebungsvariablen der Hosting-Plattform setzen.

# Eigene Domain – der Endpunkt akzeptiert nur POSTs mit diesem Origin.
SITE_ORIGIN=https://deine-domain.de

# Geheimnis zum Signieren des Zeit-Tokens. Langer Zufallsstring, min. 32 Zeichen.
# Erzeugen z.B. mit:  openssl rand -hex 32
FORM_SECRET=hier-einen-langen-zufallsstring-einsetzen

# Mail-Versand (Resend). API-Key aus dem Resend-Dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=du@deine-domain.de
CONTACT_FROM=Kontakt <noreply@deine-domain.de>
